{
  "crons": [ { "path": "/api/cron/refresh", "schedule": "0 22 * * *" }, { "path": "/api/cron/anomalies", "schedule": "15 9 * * *" } ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "headers": [
    { "source": "/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
